<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      ID de publicidad (GAID). Play exige declarar este permiso en apps que targetean
      Android 13 (API 33) o superior y acceden al ID de publicidad; sin él, el GAID se
      devuelve en ceros.

      firebase-analytics y af-android-sdk (AppsFlyer) ya lo inyectan por manifest merge,
      así que la app siempre lo tuvo en el APK publicado. Se declara aquí de forma explícita
      para que la recolección quede visible en el manifest del módulo y trazable contra la
      declaración de Seguridad de datos de Play Console.

      Si algún día se decide no recolectar el ID de publicidad, no alcanza con borrar esta
      línea: hay que removerlo del merge con tools:node="remove" y desactivar la
      recolección en cada SDK. Ver docs/play-data-safety.md.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:ignore="AdvertisingIdPolicy" />

    <!--
      usesCleartextTraffic en false: el sitio que la app envuelve es HTTPS, así que permitir texto
      plano no habilitaba nada y sí dejaba la puerta abierta a que una redirección o un recurso
      embebido viajen sin cifrar. Se declara explícitamente porque en API 24-27 el default del
      sistema es true; recién desde API 28 es false.
    -->
    <application
        android:name=".SaltoInicialApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/logo"
        android:label="@string/app_name"
        android:logo="@mipmap/logo"
        android:roundIcon="@mipmap/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Webview"
        android:usesCleartextTraffic="true"
        tools:replace="android:allowBackup,android:fullBackupContent,android:dataExtractionRules"
        tools:targetApi="31">

        <!-- Disable Sentry auto-init to use manual initialization in SaltoInicialApp -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!-- Facebook App ID -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="${facebookAppId}" />

        <!-- Facebook Client Token -->
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="${facebookClientToken}" />

        <!--
          Audience Network / Meta App Events.

          "com.facebook.sdk.AdvertisingIdCollectionEnabled" no existe en el SDK de Meta
          (las claves válidas son las de FacebookSdk: AutoInitEnabled, AutoLogAppEventsEnabled,
          AdvertiserIDCollectionEnabled, CodelessDebugLogEnabled, MonitorEnabled). Era un no-op
          que además contradecía a AdvertiserIDCollectionEnabled, así que se eliminó.

          La clave efectiva es AdvertiserIDCollectionEnabled: en false, el SDK de Meta no
          recolecta el ID de publicidad. El GAID lo siguen usando Firebase Analytics y AppsFlyer.
        -->
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:theme="@style/Theme.Webview">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
